# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요.  (cp .env.example .env.local)
# .env.local 은 git 에 올라가지 않습니다. 실제 비밀값은 절대 이 파일에 적지 마세요.

# ── 1단계 (지금) ─────────────────────────────
# 사이트 대표 주소. 비워 두면 https://www.haemongru.com (lib/site.ts 의 DEFAULT_SITE_URL, 끝 슬래시는 자동으로 뗌)
# canonical, 공유 미리보기, sitemap, robots, 구조화 데이터, 공유 링크가 모두 이 주소를 씁니다.
# 배포할 때는 비워 두면 됩니다. 로컬에서 '링크 복사'한 공유 주소를 그대로 열어 보려면 http://localhost:3000 을 넣으세요.
NEXT_PUBLIC_SITE_URL=

# ── 2단계 (아직 사용 안 함) ──────────────────
# AI 해몽 (LlmProvider). 서버에서만 사용 — NEXT_PUBLIC_ 을 붙이지 마세요.
LLM_API_KEY=

# Supabase (공유 링크, 사전 데이터 DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AdSense 게시자 ID (예: ca-pub-0000000000000000)
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── 키워드 수집 스크립트 (npm run keywords) ──
# 네이버 검색광고 > 도구 > API 사용 관리 에서 발급. 서버/내 컴퓨터에서만 사용 — NEXT_PUBLIC_ 을 붙이지 마세요.
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=
# 요청 사이 간격(밀리초). 비워 두면 1000
NAVER_AD_INTERVAL_MS=
